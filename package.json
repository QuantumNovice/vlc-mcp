{
  "name": "vlc-mcp-server",
  "version": "0.1.2",
  "description": "VLC MCP server: control VLC Media Player from Claude, ChatGPT, Ollama and any Model Context Protocol (MCP) client. Play, pause, seek, volume and playlist tools.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.QuantumNovice/vlc-mcp",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "vlc-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/QuantumNovice/vlc-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "vlc",
    "vlc-media-player",
    "vlc-mcp",
    "media-player",
    "media-control",
    "claude",
    "claude-code",
    "claude-plugin",
    "claude-desktop",
    "openai",
    "ollama",
    "llm-tools",
    "ai-agent",
    "playlist",
    "typescript"
  ],
  "homepage": "https://github.com/QuantumNovice/vlc-mcp#readme",
  "bugs": {
    "url": "https://github.com/QuantumNovice/vlc-mcp/issues"
  }
}
